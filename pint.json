{
    "preset": "laravel",
    "rules": {
        "indentation_type": false,
        "concat_space": {
            "spacing": "one"
        },
        "no_alternative_syntax": false,
        "not_operator_with_successor_space": false,
        "fully_qualified_strict_types": {
            "import_symbols": false
        },
        "void_return": false
    },
    "exclude": [
        "vendor"
    ]
}
