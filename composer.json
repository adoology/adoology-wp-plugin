{
    "name": "adoology/woocommerce-connector",
    "description": "Connect WooCommerce to Adoology for catalog, customer, order, and inventory synchronization.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "homepage": "https://adoology.com",
    "authors": [
        {
            "name": "Adoology",
            "homepage": "https://adoology.com"
        }
    ],
    "keywords": [
        "wordpress",
        "woocommerce",
        "adoology"
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^1.0",
        "phpstan/phpstan": "^1.0",
        "php-stubs/wordpress-stubs": "^6.0",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Adoology\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adoology\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "format": "@php ./vendor/bin/pint --parallel",
        "refactor": "@php ./vendor/bin/rector",
        "fix": [
            "@refactor",
            "@format"
        ],
        "lint": [
            "@php ./vendor/bin/pint --test --parallel",
            "@php ./vendor/bin/rector --dry-run"
        ],
        "types": "@php ./vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "phpunit",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@types",
            "@test"
        ]
    }
}
