parameters:
    level: 5
    paths:
        - src
        - tests
        - adoology-connector.php
        - uninstall.php
    excludePaths:
        - tests/stubs.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - tests/stubs.php
    ignoreErrors:
        # Runtime environment guards (function_exists/class_exists/headers_sent)
        # become statically decidable once WordPress/WooCommerce function stubs
        # are loaded; they are intentional defensive checks.
        - message: '#^(Right side of && is always true|Ternary operator condition is always true|If condition is always true|If condition is always false|Else branch is unreachable because ternary operator condition is always true|Negated boolean expression is always false|Result of \|\| is always false|Unreachable statement - code above always terminates)#'
          path: src
        # WooCommerce accepts loosely-typed values on legacy REST/blocks/meta
        # APIs at runtime even though the stubs declare narrow signatures.
        - identifier: argument.type
          path: src/OrderForm.php
        - identifier: argument.type
          path: src/Fraud.php
        - identifier: argument.type
          path: src/IncompleteOrders.php
        - identifier: argument.type
          path: src/Webhooks.php
        - message: '#Call to an undefined method WC_Order_Item::get_product_id#'
          path: src/Fraud.php
        - message: '#Call to an undefined method WC_Product::get_variation_attributes#'
          path: src/OrderForm.php
        - message: '#invoked with 1 parameter, 0 required#'
          path: src/Webhooks.php
        - message: '#Call to function is_wp_error\(\) with non-empty-array#'
          path: src/Webhooks.php
        # Dormant legacy implementation (see README) referencing a Connection
        # API surface that was never shipped.
        - identifier: staticMethod.notFound
          path: src/Webhooks.php
        - identifier: classConstant.notFound
          path: src/Webhooks.php
        # Test fixtures keep option arrays as dynamic in-memory stores.
        - message: '#Call to function array_key_exists\(\) with mixed and array\{\} will always evaluate to false#'
          path: tests/Unit/OptionsTest.php
